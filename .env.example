NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-mini-4b-instruct
NVIDIA_TIMEOUT_SECONDS=8
NVIDIA_MAX_TOKENS=60
NVIDIA_TEMPERATURE=0.7
FIBI_ALLOW_NVIDIA=false
CLOUD_PROVIDER=disabled
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_TIMEOUT_SECONDS=8
FIBI_DATA_DIR=

# Fibi v0.12 Manual Action Core is local-only and does not need API keys.
# Safe actions are controlled in data/fibi_state.json via /actions commands.

# Fibi v0.13 Voice Command Mode is push-to-talk and local-first.
# Voice input is controlled in data/fibi_state.json via /voice commands.
